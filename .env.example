APP_NAME=dynamic-batching-inference-gateway
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080
REQUEST_ID_HEADER=X-Request-ID
BACKENDS_JSON={"gpu-a":{"base_url":"http://vllm-a:8000","api_key":"backend-a-example-key"},"gpu-b":{"base_url":"http://vllm-b:8000"}}
VLLM_CONNECT_TIMEOUT_SECONDS=5
VLLM_REQUEST_TIMEOUT_SECONDS=120
BACKEND_HEALTH_INTERVAL_SECONDS=5
BACKEND_HEALTH_TIMEOUT_SECONDS=2
MAX_COMPLETION_TOKENS=4096
MAX_CHOICES=4
TENANTS_JSON={"tenant-a":{"api_key":"tenant-a-example-key","max_inflight":4,"max_queue":8},"tenant-b":{"api_key":"tenant-b-example-key","max_inflight":2,"max_queue":4}}
GLOBAL_MAX_INFLIGHT=16
GLOBAL_MAX_QUEUE=64
ADMISSION_QUEUE_TIMEOUT_SECONDS=5
