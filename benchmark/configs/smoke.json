{
  "schema_version": 1,
  "run_id": "local-fake-smoke",
  "model": "fake-model",
  "dataset": "datasets/sample.jsonl",
  "endpoint": "/v1/chat/completions",
  "modes": ["non_streaming", "streaming"],
  "concurrency": [1, 4],
  "requests": 4,
  "warmup": 2,
  "repetitions": 1,
  "settle_seconds": 0,
  "timeout": "5s",
  "prefix_caching": "disabled",
  "vllm_version": "fake",
  "vllm_config": "configs/vllm-fake.json",
  "generation": {
    "temperature": 0,
    "top_p": 1,
    "max_tokens": 8,
    "seed": 1
  },
  "targets": [
    {
      "label": "direct",
      "base_url": "http://127.0.0.1:18000",
      "vllm_metrics_url": "http://127.0.0.1:18000/metrics",
      "output_token_counter": "vllm:generation_tokens",
      "batching_enabled": "not_applicable"
    },
    {
      "label": "gateway_no_batch",
      "base_url": "http://127.0.0.1:18000",
      "vllm_metrics_url": "http://127.0.0.1:18000/metrics",
      "output_token_counter": "vllm:generation_tokens",
      "batching_enabled": "false",
      "tenant_max_inflight": 8,
      "global_max_inflight": 8,
      "gateway_config": "configs/gateway-off.json"
    },
    {
      "label": "gateway_batch",
      "base_url": "http://127.0.0.1:18000",
      "vllm_metrics_url": "http://127.0.0.1:18000/metrics",
      "output_token_counter": "vllm:generation_tokens",
      "batching_enabled": "true",
      "batch_max_size": 2,
      "batch_max_wait_seconds": 0.001,
      "tenant_max_inflight": 8,
      "global_max_inflight": 8,
      "gateway_config": "configs/gateway-on.json"
    }
  ]
}
