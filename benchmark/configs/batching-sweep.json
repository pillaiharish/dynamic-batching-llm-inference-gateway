{
  "schema_version": 1,
  "model": "${BENCH_MODEL}",
  "dataset": "datasets/sample.jsonl",
  "endpoint": "/v1/chat/completions",
  "modes": ["non_streaming"],
  "concurrency": [16, 32],
  "requests": "auto",
  "warmup": 20,
  "repetitions": 3,
  "settle_seconds": 5,
  "timeout": "120s",
  "sample_interval": "500ms",
  "gpu_sample_interval": "500ms",
  "prefix_caching": "disabled",
  "vllm_version": "${BENCH_VLLM_VERSION}",
  "gateway_git_sha": "${BENCH_GATEWAY_GIT_SHA}",
  "vllm_config": "${BENCH_VLLM_CONFIG}",
  "environment": "${BENCH_ENVIRONMENT_JSON}",
  "generation": {
    "temperature": 0,
    "top_p": 1,
    "max_tokens": 128,
    "seed": 1
  },
  "targets": [
    {
      "label": "gateway_batch_s2_w001",
      "base_url": "${BENCH_GATEWAY_S2_W001_URL}",
      "auth_token_env": "BENCH_GATEWAY_AUTH_TOKEN",
      "gateway_metrics_url": "${BENCH_GATEWAY_S2_W001_METRICS_URL}",
      "vllm_metrics_url": "${BENCH_VLLM_METRICS_URL}",
      "output_token_counter": "gateway_observed_output_tokens_total",
      "batching_enabled": "true",
      "batch_max_size": 2,
      "batch_max_wait_seconds": 0.001,
      "tenant_max_inflight": 128,
      "global_max_inflight": 128
    },
    {
      "label": "gateway_batch_s2_w005",
      "base_url": "${BENCH_GATEWAY_S2_W005_URL}",
      "auth_token_env": "BENCH_GATEWAY_AUTH_TOKEN",
      "gateway_metrics_url": "${BENCH_GATEWAY_S2_W005_METRICS_URL}",
      "vllm_metrics_url": "${BENCH_VLLM_METRICS_URL}",
      "output_token_counter": "gateway_observed_output_tokens_total",
      "batching_enabled": "true",
      "batch_max_size": 2,
      "batch_max_wait_seconds": 0.005,
      "tenant_max_inflight": 128,
      "global_max_inflight": 128
    },
    {
      "label": "gateway_batch_s2_w010",
      "base_url": "${BENCH_GATEWAY_S2_W010_URL}",
      "auth_token_env": "BENCH_GATEWAY_AUTH_TOKEN",
      "gateway_metrics_url": "${BENCH_GATEWAY_S2_W010_METRICS_URL}",
      "vllm_metrics_url": "${BENCH_VLLM_METRICS_URL}",
      "output_token_counter": "gateway_observed_output_tokens_total",
      "batching_enabled": "true",
      "batch_max_size": 2,
      "batch_max_wait_seconds": 0.01,
      "tenant_max_inflight": 128,
      "global_max_inflight": 128
    },
    {
      "label": "gateway_batch_s4_w001",
      "base_url": "${BENCH_GATEWAY_S4_W001_URL}",
      "auth_token_env": "BENCH_GATEWAY_AUTH_TOKEN",
      "gateway_metrics_url": "${BENCH_GATEWAY_S4_W001_METRICS_URL}",
      "vllm_metrics_url": "${BENCH_VLLM_METRICS_URL}",
      "output_token_counter": "gateway_observed_output_tokens_total",
      "batching_enabled": "true",
      "batch_max_size": 4,
      "batch_max_wait_seconds": 0.001,
      "tenant_max_inflight": 128,
      "global_max_inflight": 128
    },
    {
      "label": "gateway_batch_s4_w005",
      "base_url": "${BENCH_GATEWAY_S4_W005_URL}",
      "auth_token_env": "BENCH_GATEWAY_AUTH_TOKEN",
      "gateway_metrics_url": "${BENCH_GATEWAY_S4_W005_METRICS_URL}",
      "vllm_metrics_url": "${BENCH_VLLM_METRICS_URL}",
      "output_token_counter": "gateway_observed_output_tokens_total",
      "batching_enabled": "true",
      "batch_max_size": 4,
      "batch_max_wait_seconds": 0.005,
      "tenant_max_inflight": 128,
      "global_max_inflight": 128
    },
    {
      "label": "gateway_batch_s4_w010",
      "base_url": "${BENCH_GATEWAY_S4_W010_URL}",
      "auth_token_env": "BENCH_GATEWAY_AUTH_TOKEN",
      "gateway_metrics_url": "${BENCH_GATEWAY_S4_W010_METRICS_URL}",
      "vllm_metrics_url": "${BENCH_VLLM_METRICS_URL}",
      "output_token_counter": "gateway_observed_output_tokens_total",
      "batching_enabled": "true",
      "batch_max_size": 4,
      "batch_max_wait_seconds": 0.01,
      "tenant_max_inflight": 128,
      "global_max_inflight": 128
    },
    {
      "label": "gateway_batch_s8_w001",
      "base_url": "${BENCH_GATEWAY_S8_W001_URL}",
      "auth_token_env": "BENCH_GATEWAY_AUTH_TOKEN",
      "gateway_metrics_url": "${BENCH_GATEWAY_S8_W001_METRICS_URL}",
      "vllm_metrics_url": "${BENCH_VLLM_METRICS_URL}",
      "output_token_counter": "gateway_observed_output_tokens_total",
      "batching_enabled": "true",
      "batch_max_size": 8,
      "batch_max_wait_seconds": 0.001,
      "tenant_max_inflight": 128,
      "global_max_inflight": 128
    },
    {
      "label": "gateway_batch_s8_w005",
      "base_url": "${BENCH_GATEWAY_S8_W005_URL}",
      "auth_token_env": "BENCH_GATEWAY_AUTH_TOKEN",
      "gateway_metrics_url": "${BENCH_GATEWAY_S8_W005_METRICS_URL}",
      "vllm_metrics_url": "${BENCH_VLLM_METRICS_URL}",
      "output_token_counter": "gateway_observed_output_tokens_total",
      "batching_enabled": "true",
      "batch_max_size": 8,
      "batch_max_wait_seconds": 0.005,
      "tenant_max_inflight": 128,
      "global_max_inflight": 128
    },
    {
      "label": "gateway_batch_s8_w010",
      "base_url": "${BENCH_GATEWAY_S8_W010_URL}",
      "auth_token_env": "BENCH_GATEWAY_AUTH_TOKEN",
      "gateway_metrics_url": "${BENCH_GATEWAY_S8_W010_METRICS_URL}",
      "vllm_metrics_url": "${BENCH_VLLM_METRICS_URL}",
      "output_token_counter": "gateway_observed_output_tokens_total",
      "batching_enabled": "true",
      "batch_max_size": 8,
      "batch_max_wait_seconds": 0.01,
      "tenant_max_inflight": 128,
      "global_max_inflight": 128
    }
  ],
  "policy_grid": {
    "max_size": [2, 4, 8],
    "max_wait_seconds": [0.001, 0.005, 0.01],
    "note": "Define one independently configured gateway URL per grid point, or use --target to run selected policies after manual reconfiguration. run_matrix never edits source or restarts gateway code."
  }
}
